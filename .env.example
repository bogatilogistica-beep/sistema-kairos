# Copia este archivo a .env.local para desarrollo local, o configura estas variables
# en Vercel → Project Settings → Environment Variables para producción.
#
# Ninguna es obligatoria: si ninguna está presente, la plataforma calcula distancias
# con coordenadas GPS (Haversine + factor vial) automáticamente, sin costo.
# Si agregas UNA de las dos, la plataforma usa distancias y tiempos de manejo reales.

# Opción A: Google Maps (requiere cuenta de facturación en Google Cloud)
# - GOOGLE_MAPS_API_KEY: se usa en el servidor para la Distance Matrix API (distancias/tiempos reales).
# - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: se envía al navegador para dibujar el mapa con Maps JavaScript API
#   en vez de OpenStreetMap. Puede ser la misma key que la anterior (habilitando ambas APIs en Google
#   Cloud: "Distance Matrix API" y "Maps JavaScript API") o una distinta si prefieres separarlas.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opción B: Mapbox Directions Matrix API (tiene capa gratuita generosa, no requiere tarjeta para empezar)
MAPBOX_TOKEN=

# Opción C (RECOMENDADA): OSRM autoalojado sobre el mapa vial de Ecuador.
# Gratis, sin API key, sin límite de consultas, y resuelve la matriz completa de los 157 PDV
# en una sola llamada (Google exige trocear de 10 en 10; Mapbox no pasa de 25 puntos).
# Tiene prioridad sobre las opciones A y B si está configurada.
#
# Montarlo:
#   curl -O https://download.geofabrik.de/south-america/ecuador-latest.osm.pbf
#   docker run --rm -v "$PWD:/data" ghcr.io/project-osrm/osrm-backend osrm-extract -p /opt/car.lua /data/ecuador-latest.osm.pbf
#   docker run --rm -v "$PWD:/data" ghcr.io/project-osrm/osrm-backend osrm-partition /data/ecuador-latest.osrm
#   docker run --rm -v "$PWD:/data" ghcr.io/project-osrm/osrm-backend osrm-customize /data/ecuador-latest.osrm
#   docker run -d -p 5000:5000 -v "$PWD:/data" ghcr.io/project-osrm/osrm-backend \
#     osrm-routed --algorithm mld --max-table-size 1000 /data/ecuador-latest.osrm
#
# --max-table-size 1000 es obligatorio: el valor por defecto (100) hace fallar la matriz.
OSRM_URL=
